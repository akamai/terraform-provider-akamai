      "title": "AI-Detected SQL Injection Attack",
      "riskScoreGroup": "SQL_AI",
      "ruleDescription": "A SQL Injection attack consists of insertion or injection of a SQL query via the input data from the client to the application.",
      "action": "alert",
      "conditionExceptions": [
        {
          "exception": {
            "specificHeaderCookieParamXmlOrJsonNames": [
              {
                "names": ["test"],
                "selector": "REQUEST_COOKIES_NAMES",
                "wildcard": true
              }
            ]
          }
        }
      ]
    },
    {
